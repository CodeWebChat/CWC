    "publish:chrome": "tsx scripts/publish-chrome.ts"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/webextension-polyfill": "0.12.6",
    "baseline-browser-mapping": "2.11.35",
    "sass-embedded": "1.89.2",
    "tsx": "4.23.15",
    "vite": "8.3.6",
    "webextension-polyfill": "0.12.0"
  },
  "dependencies": {
    "@cwc/ui": "workspace:*",
    "@cwc/shared": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
