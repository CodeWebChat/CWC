{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["../../packages/shared/src/*"],
      "@ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "vite.config.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/ui/src/**/*"
  ]
}
